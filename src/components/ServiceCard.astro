---
interface Props {
  image: string;
  imageAlt: string;
  titulo: string;
  descricao: string;
  preco: string;
  link: string;
  tag?: string;
  icon?: string;
  id?: string;
}

const {
  image,
  imageAlt,
  titulo,
  descricao,
  preco,
  link,
  tag,
  icon = "ph-scissors",
  id,
} = Astro.props;
---

<article class="service-card card fade-in" id={id}>
  <div class="service-img-wrap">
    <img src={image} alt={imageAlt} loading="lazy" class="service-img" />
    {tag && <span class="service-tag">{tag}</span>}
  </div>
  <div class="service-body">
    <div class="service-icon">
      <i class={`ph-fill ${icon}`}></i>
    </div>
    <h3 class="service-title">{titulo}</h3>
    <p class="service-desc">{descricao}</p>
    <div class="service-footer">
      <div class="service-price">
        <span class="from">A partir de</span>
        <span class="price">{preco}</span>
      </div>
      <a href={link} class="btn btn-primary btn-sm">
        Agendar
        <i class="ph ph-arrow-right"></i>
      </a>
    </div>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
  }

  .service-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-img {
    transform: scale(1.05);
  }

  .service-tag {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--primary);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .service-body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .service-icon {
    width: 48px;
    height: 48px;
    background: var(--primary-light);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 1.4rem;
    margin-bottom: 16px;
  }

  .service-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 10px;
    color: var(--dark);
  }

  .service-desc {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.7;
    flex: 1;
    margin-bottom: 20px;
  }

  .service-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }

  .service-price {
    display: flex;
    flex-direction: column;
  }

  .from {
    font-size: 0.72rem;
    color: var(--gray);
    font-weight: 500;
  }

  .price {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--primary);
    line-height: 1;
  }
</style>
