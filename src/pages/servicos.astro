---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";

const allServices = [
  {
    image: "https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?w=800&q=80",
    imageAlt: "Profissional realizando banho e tosa em cachorro",
    titulo: "Banho e Tosa Completo",
    descricao: "Inclui banho, secagem, tosa na raça, escovação dos dentes, limpeza de ouvidos, corte de unhas e perfume.",
    preco: "R$ 50",
    link: "/agendamento",
    tag: "Mais popular",
    icon: "ph-shower",
    id: "banho-tosa",
  },
  {
    image: "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=800&q=80",
    imageAlt: "Gato fofo sendo cuidado",
    titulo: "Banho Simples",
    descricao: "Banho com shampoo premium, condicionador, secagem e finalização com perfume. Ideal para manutenção semanal.",
    preco: "R$ 30",
    link: "/agendamento",
    icon: "ph-drop",
    id: "banho-simples",
  },
  {
    image: "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=800&q=80",
    imageAlt: "Cachorro com tosa higiênica bem feita",
    titulo: "Tosa Higiênica",
    descricao: "Remoção de pelos nas regiões íntimas, entre os coxins e ao redor dos olhos. Higiene e conforto para seu pet.",
    preco: "R$ 35",
    link: "/agendamento",
    icon: "ph-scissors",
    id: "tosa-higienica",
  },
  {
    image: "https://images.unsplash.com/photo-1576201836106-db1758fd1c97?w=800&q=80",
    imageAlt: "Veterinária examinando animal",
    titulo: "Consulta Veterinária",
    descricao: "Atendimento clínico geral, vacinas, vermifugação, exames preventivos e orientações nutricionais para seu pet.",
    preco: "R$ 120",
    link: "/agendamento",
    icon: "ph-stethoscope",
    id: "veterinario",
  },
  {
    image: "https://images.unsplash.com/photo-1552053831-71594a27632d?w=800&q=80",
    imageAlt: "Espaço confortável do hotel pet",
    titulo: "Hotel Pet",
    descricao: "Acomodações confortáveis, alimentação especial, passeios diários e muito amor enquanto você viaja.",
    preco: "R$ 80",
    link: "/agendamento",
    icon: "ph-house-heart",
    id: "hotel-pet",
  },
  {
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80",
    imageAlt: "Cão sendo adestrado com profissional",
    titulo: "Adestramento",
    descricao: "Sessões individuais de adestramento com técnicas positivas. Corrigimos comportamentos e ensinamos comandos básicos.",
    preco: "R$ 150",
    link: "/agendamento",
    icon: "ph-hand",
    id: "adestramento",
  },
];

const diferenciais = [
  { icon: "ph-certificate", titulo: "Certificados", desc: "Todos os profissionais possuem certificação reconhecida." },
  { icon: "ph-shield-check", titulo: "Seguro Animal", desc: "Seu pet está protegido durante todo o atendimento." },
  { icon: "ph-leaf", titulo: "Produtos Naturais", desc: "Linha de produtos 100% naturais e hipoalergênicos." },
  { icon: "ph-camera", titulo: "Fotos em Tempo Real", desc: "Enviamos fotos do seu pet durante o atendimento." },
  { icon: "ph-truck", titulo: "Leva e Traz", desc: "Busca e entrega do seu pet em Campo Grande." },
  { icon: "ph-clock", titulo: "Pontualidade", desc: "Respeitamos seu horário. Atendimento no prazo combinado." },
];

const pricingTable = [
  { servico: "Banho Simples", pequeno: "R$ 30", medio: "R$ 45", grande: "R$ 60" },
  { servico: "Banho e Tosa", pequeno: "R$ 50", medio: "R$ 75", grande: "R$ 100" },
  { servico: "Tosa Higiênica", pequeno: "R$ 35", medio: "R$ 45", grande: "R$ 55" },
  { servico: "Tosa na Raça", pequeno: "R$ 40", medio: "R$ 65", grande: "R$ 90" },
  { servico: "Banho + Hidratação", pequeno: "R$ 50", medio: "R$ 70", grande: "R$ 90" },
  { servico: "Hotel Pet (diária)", pequeno: "R$ 80", medio: "R$ 90", grande: "R$ 100" },
];
---

<Layout
  title="Serviços — PetHappy Pet Shop Campo Grande"
  description="Veja todos os serviços do PetHappy: banho e tosa, consulta veterinária, hotel pet, adestramento e muito mais em Campo Grande, MS."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="breadcrumb fade-in">
        <a href="/">Início</a>
        <i class="ph ph-caret-right"></i>
        <span>Serviços</span>
      </div>
      <h1 class="page-hero-title fade-in">
        Nossos <span class="text-primary">Serviços</span>
      </h1>
      <p class="page-hero-subtitle fade-in">
        Do banho à consulta veterinária, oferecemos tudo que seu pet precisa.
        Qualidade, carinho e profissionalismo em Campo Grande, MS.
      </p>
    </div>
    <div class="page-hero-wave">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 80L80 68C160 56 320 32 480 24C640 16 800 24 960 32C1120 40 1280 48 1360 52L1440 56V80H1360C1280 80 1120 80 960 80C800 80 640 80 480 80C320 80 160 80 80 80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge fade-in"><i class="ph-fill ph-paw-print"></i> Catálogo completo</div>
        <h2 class="section-title fade-in">Tudo para o seu <span class="text-primary">Pet</span></h2>
        <p class="section-subtitle fade-in">
          Cada serviço é realizado com produtos premium e por profissionais apaixonados por animais.
        </p>
      </div>
      <div class="grid-3">
        {allServices.map((s) => (
          <ServiceCard {...s} />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="section-header">
        <div class="badge fade-in"><i class="ph-fill ph-star"></i> Por que a PetHappy?</div>
        <h2 class="section-title fade-in">Nossos <span class="text-primary">Diferenciais</span></h2>
      </div>
      <div class="diferenciais-grid">
        {diferenciais.map((d) => (
          <div class="diferencial-card fade-in">
            <div class="diferencial-icon">
              <i class={`ph-fill ${d.icon}`}></i>
            </div>
            <div>
              <h3 class="diferencial-title">{d.titulo}</h3>
              <p class="diferencial-desc">{d.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge fade-in"><i class="ph-fill ph-tag"></i> Tabela de Preços</div>
        <h2 class="section-title fade-in">Preços por <span class="text-primary">Porte</span></h2>
        <p class="section-subtitle fade-in">
          Pequeno: até 10kg &nbsp;|&nbsp; Médio: 10–25kg &nbsp;|&nbsp; Grande: acima de 25kg
        </p>
      </div>

      <div class="pricing-table-wrap fade-in">
        <table class="pricing-table">
          <thead>
            <tr>
              <th class="service-col">Serviço</th>
              <th>
                <div class="porte-header">
                  <i class="ph-fill ph-dog"></i>
                  Pequeno
                </div>
              </th>
              <th>
                <div class="porte-header">
                  <i class="ph-fill ph-dog"></i>
                  Médio
                </div>
              </th>
              <th>
                <div class="porte-header popular">
                  <i class="ph-fill ph-dog"></i>
                  Grande
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            {pricingTable.map((row) => (
              <tr>
                <td class="service-name">{row.servico}</td>
                <td><span class="price-cell">{row.pequeno}</span></td>
                <td><span class="price-cell">{row.medio}</span></td>
                <td><span class="price-cell">{row.grande}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="pricing-obs fade-in">
        <i class="ph ph-info"></i>
        Preços sujeitos a alteração conforme raça e condição do pelo. Consulte-nos pelo WhatsApp.
      </p>
    </div>
  </section>

  <section class="services-cta-section">
    <div class="container services-cta-inner">
      <h2 class="fade-in">Agende o serviço ideal para o seu pet</h2>
      <p class="fade-in">Atendimento personalizado em Campo Grande, MS. Ligue ou agende online agora!</p>
      <div class="services-cta-actions fade-in">
        <a href="/agendamento" class="btn btn-white btn-lg">
          <i class="ph ph-calendar-plus"></i>
          Agendar Online
        </a>
        <a href="https://wa.me/5567999998888" target="_blank" class="btn btn-lg" style="background:#25d366; color:white;">
          <i class="ph-fill ph-whatsapp-logo"></i>
          Chamar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--primary) 0%, #ff8e53 100%);
    padding: 80px 0 0;
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: rgba(255,255,255,0.06);
    border-radius: 50%;
  }

  .page-hero-inner {
    text-align: center;
    padding-bottom: 48px;
    position: relative;
    z-index: 1;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.75);
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: rgba(255,255,255,0.75);
    transition: color var(--transition);
  }

  .breadcrumb a:hover {
    color: white;
  }

  .page-hero-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: white;
    margin-bottom: 16px;
  }

  .page-hero-title .text-primary {
    color: var(--accent);
  }

  .page-hero-subtitle {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.85);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .page-hero-wave {
    line-height: 0;
    margin-bottom: -2px;
  }

  .diferenciais-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .diferencial-card {
    background: white;
    border-radius: var(--radius-md);
    padding: 28px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.04);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .diferencial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .diferencial-icon {
    width: 52px;
    height: 52px;
    background: var(--secondary-light);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--secondary-dark);
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .diferencial-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .diferencial-desc {
    font-size: 0.88rem;
    color: var(--gray);
    line-height: 1.6;
  }

  .pricing-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
  }

  .pricing-table thead {
    background: var(--dark);
    color: white;
  }

  .pricing-table th {
    padding: 18px 24px;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .pricing-table th.service-col {
    text-align: left;
  }

  .porte-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .porte-header i {
    color: var(--secondary);
    font-size: 1.1rem;
  }

  .pricing-table td {
    padding: 16px 24px;
    text-align: center;
    border-bottom: 1px solid var(--gray-light);
    font-size: 0.92rem;
  }

  .pricing-table td.service-name {
    text-align: left;
    font-weight: 600;
    color: var(--dark);
  }

  .pricing-table tbody tr:hover {
    background: var(--light);
  }

  .pricing-table tbody tr:last-child td {
    border-bottom: none;
  }

  .price-cell {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--primary);
    font-size: 1rem;
  }

  .pricing-obs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-size: 0.875rem;
    color: var(--gray);
    background: var(--light);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--secondary);
  }

  .pricing-obs i {
    color: var(--secondary);
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .services-cta-section {
    background: linear-gradient(135deg, var(--secondary) 0%, #2196a8 100%);
    padding: 72px 0;
    text-align: center;
  }

  .services-cta-inner h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    color: white;
    margin-bottom: 12px;
  }

  .services-cta-inner p {
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    margin-bottom: 32px;
  }

  .services-cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .diferenciais-grid {
      grid-template-columns: 1fr;
    }

    .pricing-table th,
    .pricing-table td {
      padding: 12px 16px;
    }
  }
</style>
