---
import Layout from "../layouts/Layout.astro";

const steps = ["Escolher Serviço", "Dados do Pet", "Confirmação"];

const servicos = [
  { id: "banho-tosa", icon: "ph-shower", nome: "Banho e Tosa", preco: "A partir de R$ 50", desc: "Banho completo + tosa na raça" },
  { id: "banho-simples", icon: "ph-drop", nome: "Banho Simples", preco: "A partir de R$ 30", desc: "Banho com shampoo premium" },
  { id: "tosa-higienica", icon: "ph-scissors", nome: "Tosa Higiênica", preco: "A partir de R$ 35", desc: "Higiene e conforto para o pet" },
  { id: "veterinario", icon: "ph-stethoscope", nome: "Consulta Veterinária", preco: "R$ 120", desc: "Atendimento clínico completo" },
  { id: "hotel-pet", icon: "ph-house-heart", nome: "Hotel Pet", preco: "A partir de R$ 80/diária", desc: "Hospedagem com muito carinho" },
  { id: "adestramento", icon: "ph-hand", nome: "Adestramento", preco: "R$ 150/sessão", desc: "Técnicas positivas e eficazes" },
];

const horarios = ["08:00", "09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00", "17:00"];
---

<Layout
  title="Agendamento Online — PetHappy Campo Grande"
  description="Agende banho, tosa, consulta veterinária ou hotel pet de forma rápida e fácil. PetHappy, Campo Grande MS."
>
  <section class="agendamento-page">
    <div class="container">
      <div class="agendamento-header">
        <div class="breadcrumb">
          <a href="/">Início</a>
          <i class="ph ph-caret-right"></i>
          <span>Agendamento</span>
        </div>
        <h1>Agendar <span class="text-primary">Serviço</span></h1>
        <p>Preencha os dados abaixo para agendar. Simples, rápido e fácil!</p>
      </div>

      <div class="agendamento-wrap">
        <div class="progress-bar-wrap">
          <div class="progress-steps">
            {steps.map((s, i) => (
              <div class="progress-step" data-step={i + 1}>
                <div class="step-circle">
                  <span class="step-num">{i + 1}</span>
                  <i class="ph-fill ph-check step-check" style="display:none;"></i>
                </div>
                <span class="step-label">{s}</span>
              </div>
            ))}
          </div>
          <div class="progress-line">
            <div class="progress-line-fill" id="progressFill"></div>
          </div>
        </div>

        <div class="agendamento-form-wrap">
          <!-- STEP 1: Serviço -->
          <div class="step-content active" id="step1">
            <h2 class="step-title">Qual serviço você precisa?</h2>
            <p class="step-subtitle">Clique no serviço para selecioná-lo</p>
            <div class="servicos-grid" id="servicosGrid">
              {servicos.map((s) => (
                <button
                  type="button"
                  class="servico-btn"
                  data-id={s.id}
                  data-nome={s.nome}
                  data-preco={s.preco}
                >
                  <div class="servico-btn-icon">
                    <i class={`ph-fill ${s.icon}`}></i>
                  </div>
                  <div class="servico-btn-info">
                    <h3>{s.nome}</h3>
                    <p>{s.desc}</p>
                    <span class="servico-preco">{s.preco}</span>
                  </div>
                  <div class="servico-check">
                    <i class="ph-fill ph-check-circle"></i>
                  </div>
                </button>
              ))}
            </div>
            <div class="step-actions">
              <div></div>
              <button type="button" class="btn btn-primary btn-lg" id="goStep2" disabled>
                Próximo
                <i class="ph ph-arrow-right"></i>
              </button>
            </div>
          </div>

          <!-- STEP 2: Dados do Pet -->
          <div class="step-content" id="step2" style="display:none;">
            <h2 class="step-title">Dados do seu <span class="text-primary">pet</span></h2>
            <p class="step-subtitle">Nos conte um pouco sobre o seu companheiro</p>

            <div class="form-section">
              <h3 class="form-section-title">
                <i class="ph-fill ph-paw-print"></i>
                Sobre o Pet
              </h3>
              <div class="form-row">
                <div class="form-group">
                  <label for="pet_nome2">Nome do pet <span class="required">*</span></label>
                  <input type="text" id="pet_nome2" name="pet_nome2" placeholder="Ex: Thor" required />
                </div>
                <div class="form-group">
                  <label for="pet_especie2">Espécie <span class="required">*</span></label>
                  <select id="pet_especie2" name="pet_especie2" required>
                    <option value="">Selecione</option>
                    <option>Cachorro</option>
                    <option>Gato</option>
                    <option>Outro</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="pet_raca">Raça</label>
                  <input type="text" id="pet_raca" name="pet_raca" placeholder="Ex: Golden Retriever" />
                </div>
                <div class="form-group">
                  <label for="pet_porte">Porte</label>
                  <select id="pet_porte" name="pet_porte">
                    <option value="">Selecione</option>
                    <option>Pequeno (até 10kg)</option>
                    <option>Médio (10–25kg)</option>
                    <option>Grande (acima de 25kg)</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="pet_obs">Observações sobre o pet</label>
                <textarea id="pet_obs" name="pet_obs" rows="3" placeholder="Ex: Cachorro nervoso com banhos, alérgico a shampoo X, problemas de saúde..."></textarea>
              </div>
            </div>

            <div class="form-section">
              <h3 class="form-section-title">
                <i class="ph-fill ph-calendar-blank"></i>
                Data e Horário
              </h3>
              <div class="form-row">
                <div class="form-group">
                  <label for="data_ag">Data preferida <span class="required">*</span></label>
                  <input type="date" id="data_ag" name="data_ag" required />
                </div>
                <div class="form-group">
                  <label>Horário preferido <span class="required">*</span></label>
                  <div class="horarios-grid">
                    {horarios.map((h) => (
                      <button type="button" class="horario-btn" data-hora={h}>{h}</button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-secondary" id="backStep1">
                <i class="ph ph-arrow-left"></i>
                Voltar
              </button>
              <button type="button" class="btn btn-primary btn-lg" id="goStep3">
                Próximo
                <i class="ph ph-arrow-right"></i>
              </button>
            </div>
          </div>

          <!-- STEP 3: Confirmação -->
          <div class="step-content" id="step3" style="display:none;">
            <h2 class="step-title">Seus dados e <span class="text-primary">confirmação</span></h2>
            <p class="step-subtitle">Preencha seus dados de contato para finalizar</p>

            <div class="form-section">
              <h3 class="form-section-title">
                <i class="ph-fill ph-user"></i>
                Seus Dados
              </h3>
              <div class="form-row">
                <div class="form-group">
                  <label for="tutor_nome">Seu nome <span class="required">*</span></label>
                  <input type="text" id="tutor_nome" name="tutor_nome" placeholder="Nome completo" required autocomplete="name" />
                </div>
                <div class="form-group">
                  <label for="tutor_telefone">Telefone / WhatsApp <span class="required">*</span></label>
                  <input type="tel" id="tutor_telefone" name="tutor_telefone" placeholder="(67) 99999-0000" required autocomplete="tel" />
                </div>
              </div>
              <div class="form-group">
                <label for="tutor_email">Email</label>
                <input type="email" id="tutor_email" name="tutor_email" placeholder="seu@email.com" autocomplete="email" />
              </div>
            </div>

            <div class="resumo-card">
              <h3 class="resumo-title">
                <i class="ph-fill ph-clipboard-text"></i>
                Resumo do Agendamento
              </h3>
              <div class="resumo-grid">
                <div class="resumo-item">
                  <span class="resumo-label">Serviço</span>
                  <span class="resumo-value" id="resumo-servico">—</span>
                </div>
                <div class="resumo-item">
                  <span class="resumo-label">Preço estimado</span>
                  <span class="resumo-value text-primary" id="resumo-preco">—</span>
                </div>
                <div class="resumo-item">
                  <span class="resumo-label">Pet</span>
                  <span class="resumo-value" id="resumo-pet">—</span>
                </div>
                <div class="resumo-item">
                  <span class="resumo-label">Data e Horário</span>
                  <span class="resumo-value" id="resumo-data">—</span>
                </div>
                <div class="resumo-item">
                  <span class="resumo-label">Local</span>
                  <span class="resumo-value">Rua das Flores, 123 — Jardim dos Estados</span>
                </div>
              </div>
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-secondary" id="backStep2">
                <i class="ph ph-arrow-left"></i>
                Voltar
              </button>
              <button type="button" class="btn btn-primary btn-lg" id="confirmarBtn">
                <i class="ph ph-check"></i>
                <span class="btn-text-conf">Confirmar Agendamento</span>
                <span class="btn-loading-conf" style="display:none;">
                  <span class="spinner"></span>
                  Confirmando...
                </span>
              </button>
            </div>
          </div>

          <!-- SUCESSO -->
          <div class="step-content" id="stepSuccess" style="display:none;">
            <div class="success-agendamento">
              <div class="success-animation">
                <div class="success-circle">
                  <i class="ph-fill ph-check"></i>
                </div>
              </div>
              <h2>Agendamento Confirmado!</h2>
              <p>Seu pet está na agenda da PetHappy. Aguardamos vocês!</p>

              <div class="success-details">
                <div class="resumo-card" style="margin-top: 0;">
                  <div class="resumo-grid">
                    <div class="resumo-item">
                      <span class="resumo-label">Serviço</span>
                      <span class="resumo-value" id="final-servico">—</span>
                    </div>
                    <div class="resumo-item">
                      <span class="resumo-label">Pet</span>
                      <span class="resumo-value" id="final-pet">—</span>
                    </div>
                    <div class="resumo-item">
                      <span class="resumo-label">Data e Horário</span>
                      <span class="resumo-value" id="final-data">—</span>
                    </div>
                    <div class="resumo-item">
                      <span class="resumo-label">Endereço</span>
                      <span class="resumo-value">Rua das Flores, 123 — Jardim dos Estados, Campo Grande, MS</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="success-actions">
                <button type="button" class="btn btn-lg" id="waBtn" style="background:#25d366; color:white; box-shadow: 0 8px 24px rgba(37,211,102,0.35);">
                  <i class="ph-fill ph-whatsapp-logo"></i>
                  Salvar no WhatsApp
                </button>
                <a href="/" class="btn btn-secondary btn-lg">
                  <i class="ph ph-house"></i>
                  Voltar ao início
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .agendamento-page {
    background: var(--light);
    min-height: calc(100vh - 72px);
    padding: 56px 0 80px;
  }

  .agendamento-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--gray);
    margin-bottom: 16px;
  }

  .breadcrumb a {
    color: var(--gray);
    transition: color var(--transition);
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .agendamento-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    margin-bottom: 12px;
  }

  .agendamento-header p {
    color: var(--gray);
    font-size: 1.05rem;
  }

  .agendamento-wrap {
    max-width: 820px;
    margin: 0 auto;
  }

  .progress-bar-wrap {
    margin-bottom: 40px;
  }

  .progress-steps {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }

  .progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
  }

  .step-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--gray-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    color: var(--gray);
    transition: background var(--transition), border-color var(--transition), color var(--transition);
    position: relative;
    z-index: 2;
  }

  .progress-step.active .step-circle {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
    box-shadow: 0 4px 12px rgba(255,107,107,0.35);
  }

  .progress-step.done .step-circle {
    background: #22c55e;
    border-color: #22c55e;
    color: white;
  }

  .progress-step.done .step-num {
    display: none;
  }

  .progress-step.done .step-check {
    display: block !important;
  }

  .step-label {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gray);
    text-align: center;
    transition: color var(--transition);
  }

  .progress-step.active .step-label,
  .progress-step.done .step-label {
    color: var(--dark);
  }

  .progress-line {
    height: 3px;
    background: var(--gray-light);
    border-radius: 100px;
    margin: 0 8%;
    position: relative;
    top: -28px;
    z-index: 0;
  }

  .progress-line-fill {
    height: 100%;
    background: var(--primary);
    border-radius: 100px;
    width: 0%;
    transition: width 0.4s ease;
  }

  .agendamento-form-wrap {
    background: white;
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-lg);
  }

  .step-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .step-subtitle {
    color: var(--gray);
    font-size: 0.9rem;
    margin-bottom: 32px;
  }

  .servicos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }

  .servico-btn {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: var(--light);
    border: 2px solid var(--gray-light);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
    position: relative;
    width: 100%;
  }

  .servico-btn:hover {
    border-color: var(--primary-light);
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  .servico-btn.selected {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .servico-btn-icon {
    width: 52px;
    height: 52px;
    background: white;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .servico-btn.selected .servico-btn-icon {
    background: var(--primary);
    color: white;
  }

  .servico-btn-info {
    flex: 1;
    min-width: 0;
  }

  .servico-btn-info h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .servico-btn-info p {
    font-size: 0.78rem;
    color: var(--gray);
    margin-bottom: 4px;
  }

  .servico-preco {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
  }

  .servico-check {
    font-size: 1.4rem;
    color: var(--primary);
    opacity: 0;
    transition: opacity var(--transition);
    flex-shrink: 0;
  }

  .servico-btn.selected .servico-check {
    opacity: 1;
  }

  .step-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--gray-light);
  }

  .form-section {
    background: var(--light);
    border-radius: var(--radius-md);
    padding: 24px;
    margin-bottom: 20px;
  }

  .form-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 20px;
  }

  .form-section-title i {
    color: var(--primary);
    font-size: 1.1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--dark);
  }

  .required { color: var(--primary); }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 11px 14px;
    border: 2px solid var(--gray-light);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    color: var(--dark);
    background: white;
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
    width: 100%;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(255,107,107,0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 90px;
  }

  .horarios-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .horario-btn {
    padding: 8px;
    background: white;
    border: 2px solid var(--gray-light);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--dark);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition), color var(--transition);
    text-align: center;
  }

  .horario-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .horario-btn.selected {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  .resumo-card {
    background: var(--light);
    border-radius: var(--radius-md);
    padding: 24px;
    border: 1px solid var(--gray-light);
    margin-top: 20px;
  }

  .resumo-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--dark);
  }

  .resumo-title i {
    color: var(--primary);
    font-size: 1.2rem;
  }

  .resumo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .resumo-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .resumo-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .resumo-value {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--dark);
  }

  .success-agendamento {
    text-align: center;
    padding: 32px 0;
  }

  .success-animation {
    margin-bottom: 28px;
  }

  .success-circle {
    width: 88px;
    height: 88px;
    background: #22c55e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: white;
    margin: 0 auto;
    box-shadow: 0 0 0 12px rgba(34,197,94,0.15);
    animation: successPop 0.5s ease-out;
  }

  @keyframes successPop {
    0% { transform: scale(0.5); opacity: 0; }
    70% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }

  .success-agendamento h2 {
    font-size: 1.8rem;
    font-weight: 900;
    margin-bottom: 10px;
  }

  .success-agendamento > p {
    color: var(--gray);
    font-size: 1rem;
    margin-bottom: 28px;
  }

  .success-details {
    text-align: left;
    max-width: 560px;
    margin: 0 auto 32px;
  }

  .success-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 4px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .agendamento-form-wrap {
      padding: 24px;
    }

    .servicos-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .resumo-grid {
      grid-template-columns: 1fr;
    }

    .step-label {
      display: none;
    }
  }
</style>

<script>
  let currentStep = 1;
  let selectedServico = { id: "", nome: "", preco: "" };
  let selectedHora = "";

  const steps = [
    document.getElementById("step1"),
    document.getElementById("step2"),
    document.getElementById("step3"),
    document.getElementById("stepSuccess"),
  ];

  const progressFill = document.getElementById("progressFill") as HTMLDivElement;
  const progressStepEls = document.querySelectorAll(".progress-step");

  function updateProgress(step: number) {
    const pct = step === 1 ? 0 : step === 2 ? 50 : step === 3 ? 100 : 100;
    progressFill.style.width = pct + "%";

    progressStepEls.forEach((el, i) => {
      el.classList.remove("active", "done");
      if (i + 1 === step) el.classList.add("active");
      else if (i + 1 < step) el.classList.add("done");
    });
  }

  function showStep(step: number) {
    steps.forEach((s, i) => {
      if (s) s.style.display = i === step - 1 ? "block" : "none";
    });
    currentStep = step;
    updateProgress(step);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  updateProgress(1);

  document.querySelectorAll(".servico-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".servico-btn").forEach((b) => b.classList.remove("selected"));
      btn.classList.add("selected");
      selectedServico = {
        id: btn.getAttribute("data-id") || "",
        nome: btn.getAttribute("data-nome") || "",
        preco: btn.getAttribute("data-preco") || "",
      };
      (document.getElementById("goStep2") as HTMLButtonElement).disabled = false;
    });
  });

  document.getElementById("goStep2")?.addEventListener("click", () => showStep(2));
  document.getElementById("backStep1")?.addEventListener("click", () => showStep(1));

  document.querySelectorAll(".horario-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".horario-btn").forEach((b) => b.classList.remove("selected"));
      btn.classList.add("selected");
      selectedHora = btn.getAttribute("data-hora") || "";
    });
  });

  document.getElementById("goStep3")?.addEventListener("click", () => {
    const petNome = (document.getElementById("pet_nome2") as HTMLInputElement).value;
    const petEspecie = (document.getElementById("pet_especie2") as HTMLSelectElement).value;
    const dataAg = (document.getElementById("data_ag") as HTMLInputElement).value;

    if (!petNome || !petEspecie || !dataAg || !selectedHora) {
      alert("Por favor, preencha todos os campos obrigatórios e selecione um horário.");
      return;
    }

    const petRaca = (document.getElementById("pet_raca") as HTMLInputElement).value;
    const petLabel = petNome + (petRaca ? ` (${petRaca})` : "") + ` — ${petEspecie}`;
    const dataFormatada = new Date(dataAg + "T00:00:00").toLocaleDateString("pt-BR", {
      weekday: "long",
      day: "2-digit",
      month: "long",
      year: "numeric",
    });

    const resumoServico = document.getElementById("resumo-servico");
    const resumoPreco = document.getElementById("resumo-preco");
    const resumoPet = document.getElementById("resumo-pet");
    const resumoData = document.getElementById("resumo-data");

    if (resumoServico) resumoServico.textContent = selectedServico.nome;
    if (resumoPreco) resumoPreco.textContent = selectedServico.preco;
    if (resumoPet) resumoPet.textContent = petLabel;
    if (resumoData) resumoData.textContent = `${dataFormatada} às ${selectedHora}`;

    showStep(3);
  });

  document.getElementById("backStep2")?.addEventListener("click", () => showStep(2));

  const confirmarBtn = document.getElementById("confirmarBtn") as HTMLButtonElement;
  confirmarBtn?.addEventListener("click", async () => {
    const tutorNome = (document.getElementById("tutor_nome") as HTMLInputElement).value;
    const tutorTelefone = (document.getElementById("tutor_telefone") as HTMLInputElement).value;

    if (!tutorNome || !tutorTelefone) {
      alert("Por favor, preencha seu nome e telefone.");
      return;
    }

    const btnTextConf = confirmarBtn.querySelector(".btn-text-conf") as HTMLElement;
    const btnLoadingConf = confirmarBtn.querySelector(".btn-loading-conf") as HTMLElement;

    btnTextConf.style.display = "none";
    btnLoadingConf.style.display = "inline-flex";
    confirmarBtn.disabled = true;

    await new Promise((r) => setTimeout(r, 2000));

    const petNome = (document.getElementById("pet_nome2") as HTMLInputElement).value;
    const petEspecie = (document.getElementById("pet_especie2") as HTMLSelectElement).value;
    const petRaca = (document.getElementById("pet_raca") as HTMLInputElement).value;
    const dataAg = (document.getElementById("data_ag") as HTMLInputElement).value;

    const petLabel = petNome + (petRaca ? ` (${petRaca})` : "") + ` — ${petEspecie}`;
    const dataFormatada = new Date(dataAg + "T00:00:00").toLocaleDateString("pt-BR", {
      weekday: "long",
      day: "2-digit",
      month: "long",
      year: "numeric",
    });

    const finalServico = document.getElementById("final-servico");
    const finalPet = document.getElementById("final-pet");
    const finalData = document.getElementById("final-data");

    if (finalServico) finalServico.textContent = selectedServico.nome;
    if (finalPet) finalPet.textContent = petLabel;
    if (finalData) finalData.textContent = `${dataFormatada} às ${selectedHora}`;

    const waMsg = `Olá! Gostaria de confirmar meu agendamento na PetHappy:\n\n` +
      `👤 Tutor: ${tutorNome}\n` +
      `🐾 Pet: ${petLabel}\n` +
      `✂️ Serviço: ${selectedServico.nome}\n` +
      `📅 Data: ${dataFormatada}\n` +
      `🕐 Horário: ${selectedHora}\n` +
      `💰 Valor: ${selectedServico.preco}\n\n` +
      `Aguardo confirmação!`;

    document.getElementById("waBtn")?.addEventListener("click", () => {
      window.open("https://wa.me/5567999998888?text=" + encodeURIComponent(waMsg), "_blank");
    });

    showStep(4);
    progressFill.style.width = "100%";
    progressStepEls.forEach((el) => el.classList.add("done"));
  });

  const phoneInput = document.getElementById("tutor_telefone") as HTMLInputElement;
  phoneInput?.addEventListener("input", (e) => {
    let val = (e.target as HTMLInputElement).value.replace(/\D/g, "");
    if (val.length <= 11) {
      val = val.replace(/^(\d{2})(\d)/, "($1) $2");
      val = val.replace(/(\d{5})(\d{4})$/, "$1-$2");
    }
    (e.target as HTMLInputElement).value = val;
  });

  const dataInput = document.getElementById("data_ag") as HTMLInputElement;
  if (dataInput) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");
    dataInput.min = `${yyyy}-${mm}-${dd}`;
  }
</script>
